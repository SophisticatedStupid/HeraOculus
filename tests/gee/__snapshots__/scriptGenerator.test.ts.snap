exports[`generateJsScript > Sentinel-2 NDVI (computed expression) snapshot 1`] = `
"// HeraOculus → Google Earth Engine (Code Editor) JavaScript
// Generated automatically. Run this in your own GEE Code Editor.
// Geo-Iris/HeraOculus does not execute, store, or transmit this code.
// Dataset: Sentinel-2 MSI Level-2A SR (Harmonized) — NDVI (B8−B4)/(B8+B4)
// eeCollectionId: COPERNICUS/S2_SR_HARMONIZED | band: B8 | scale: 0.0001 | units: index (0–1)
// Native resolution: 10 m | reducer: mean
// Region: {"kind":"point","lat":24.8948,"lon":91.8687}
// Date range: 2024-01-01 to 2024-12-31
// Variable: ndvi | export target: chart
// Geometry uses [lon, lat] ordering as required by Earth Engine.

// NDVI computed from NIR (B8) and red (B4) surface reflectance.
// The 0.0001 scale cancels in the ratio, so bands are used unscaled.
// Basic QA60 cloud mask applied (approximate; harmonized collection reconstructs QA60 from 2024-02-28).
// 10 m resolution, 5-day revisit.
// L2 coverage 2017-2018 is not yet global..

// 1. Define the geometry from the HeraOculus selection.
var geometry = ee.Point([91.8687, 24.8948]);

// 2. Load the collection, filter by date, select band(s), apply scale & masks.
var collection = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
    .filterDate('2024-01-01', '2024-12-31')
    .select(['B8', 'B4', 'QA60'])

  .map(function(img) {
    
    var scaled = img.expression("(b8 - b4) / (b8 + b4)", {b8: img.select('B8'), b4: img.select('B4')});
    
    var qa = img.select('QA60');
    var cloudBitMask = 1 << 10;
    var cloudMask = qa.bitwiseAnd(cloudBitMask).eq(0);
    scaled = scaled.updateMask(cloudMask);
    
    return scaled.rename('value').copyProperties(img, ['system:time_start']);
  })

// 3. Apply temporal aggregation.
var aggColl = collection;

// 4. Export / chart.
var chart = ui.Chart.image.seriesByRegion({
  imageCollection: aggColl,
  regions: geometry,
  reducer: ee.Reducer.mean(),
  scale: 10,
  xProperty: 'system:time_start'
});
print(chart);
// Y-axis units: index (0–1). Values already have scale 0.0001 applied.

// End of HeraOculus GEE script."
`;

exports[`generateJsScript > annual aggregation + GeoTIFF to Drive snapshot 1`] = `
"// HeraOculus → Google Earth Engine (Code Editor) JavaScript
// Generated automatically. Run this in your own GEE Code Editor.
// Geo-Iris/HeraOculus does not execute, store, or transmit this code.
// Dataset: MODIS Terra LST & Emissivity (MOD11A1 V6.1) — Daytime LST
// eeCollectionId: MODIS/061/MOD11A1 | band: LST_Day_1km | scale: 0.02 | units: K
// Native resolution: 1000 m | reducer: mean
// Region: {"kind":"point","lat":24.8948,"lon":91.8687}
// Date range: 2024-01-01 to 2024-12-31
// Variable: lst_day | export target: geotiff-drive
// Geometry uses [lon, lat] ordering as required by Earth Engine.

// Daily, 1 km.
// Apply scale 0.02 → Kelvin.
// Raw fill value is 0; valid range 7500..65535.
// Mask raw < 7500 as no-data.
// °C = K − 273.15.
// Clear-sky only; above 30° latitude multiple observations may be averaged.
// V0.61 (061); V0.06 decommissioned 2023-07-31..

// 1. Define the geometry from the HeraOculus selection.
var geometry = ee.Point([91.8687, 24.8948]);

// 2. Load the collection, filter by date, select band(s), apply scale & masks.
var collection = ee.ImageCollection('MODIS/061/MOD11A1')
    .filterDate('2024-01-01', '2024-12-31')
    .select(['LST_Day_1km'])

  .map(function(img) {
    
    var scaled = img.select('LST_Day_1km').multiply(0.02).add(0);
    
    
    scaled = scaled.updateMask(img.gte(7500));
    return scaled.rename('value').copyProperties(img, ['system:time_start']);
  })

// 3. Apply temporal aggregation.

// Aggregate to annual means.
aggColl = ee.ImageCollection.fromImages(
  years.map(function(y) {
    var c = collection
      .filter(ee.Filter.calendarRange(y, y, 'year'));
    return c.mean().set('system:time_start', ee.Date.fromYMD(y, 1, 1));
  })
);

// 4. Export / chart.
var image = aggColl.mean().clip(geometry);
Export.image.toDrive({
  image: image,
  description: 'HeraOculus_lst_day_2024-01-01_2024-12-31',
  scale: 1000,
  region: geometry,
  maxPixels: 1e9
});

// End of HeraOculus GEE script."
`;

