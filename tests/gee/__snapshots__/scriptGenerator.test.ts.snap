exports[`generateJsScript > monthly aggregation + CSV to Drive snapshot 1`] = `
"// HeraOculus → Google Earth Engine (Code Editor) JavaScript
// Generated automatically. Run this in your own GEE Code Editor.
// Geo-Iris/HeraOculus does not execute, store, or transmit this code.
// Dataset: CHIRPS Daily Precipitation (V2 Final)
// eeCollectionId: UCSB-CHG/CHIRPS/DAILY | band: precipitation | scale: 1 | units: mm/day
// Native resolution: 5566 m | reducer: mean
// Region: {"kind":"point","lat":24.8948,"lon":91.8687}
// Date range: 2024-01-01 to 2024-12-31
// Variable: precip | export target: csv-drive
// Geometry uses [lon, lat] ordering as required by Earth Engine.

// Daily precipitation, quasi-global (60°S–60°N), ~0.05° (~5.6 km).
// No scale factor (raw values already in mm/day).
// For monthly totals, sum daily values; for annual, sum then divide by years as needed..

// 1. Define the geometry from the HeraOculus selection.
var geometry = ee.Point([91.8687, 24.8948]);

// 2. Load the collection, filter by date, select band(s), apply scale & masks.
var collection = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
    .filterDate('2024-01-01', '2024-12-31')
    .select(['precipitation'])

  .map(function(img) {
    
    var scaled = img.select('precipitation').multiply(1).add(0);
    
    
    return scaled.rename('value').copyProperties(img, ['system:time_start']);
  })

// 3. Apply temporal aggregation.

// Aggregate to monthly means.
var years = ee.List.sequence(2024, 2024);
var months = ee.List.sequence(1, 12);
aggColl = ee.ImageCollection.fromImages(
  years.map(function(y) {
    return months.map(function(m) {
      var c = collection
        .filter(ee.Filter.calendarRange(y, y, 'year'))
        .filter(ee.Filter.calendarRange(m, m, 'month'));
      return c.mean().set('system:time_start', ee.Date.fromYMD(y, m, 1));
    });
  }).flatten()
);

// 4. Export / chart.
var features = aggColl.map(function(img) {
  var val = img.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: geometry,
    scale: 5566,
    maxPixels: 1e9,
    bestEffort: true
  });
  return ee.Feature(null, {
    date: img.date().format('YYYY-MM-dd'),
    value: val.get('value')
  });
});
var fc = ee.FeatureCollection(features);
Export.table.toDrive({
  collection: fc,
  description: 'HeraOculus_precip_2024-01-01_2024-12-31',
  fileFormat: 'CSV'
});

// End of HeraOculus GEE script."
`;

exports[`generatePythonScript > CSV to Drive snapshot 1`] = `
"# HeraOculus → Google Earth Engine (Python / earthengine-api)
# Generated automatically. Run this in your own Python environment.
# HeraOculus does not execute, store, or transmit this code.
# Dataset: CHIRPS Daily Precipitation (V2 Final)
# eeCollectionId: UCSB-CHG/CHIRPS/DAILY | band: precipitation | scale: 1 | units: mm/day
# Native resolution: 5566 m | reducer: mean
# Region: {"kind":"point","lat":24.8948,"lon":91.8687}
# Date range: 2024-01-01 to 2024-12-31
# Variable: precip | export target: csv-drive
# Geometry uses [lon, lat] ordering as required by Earth Engine.

# Daily precipitation, quasi-global (60°S–60°N), ~0.05° (~5.6 km).
# No scale factor (raw values already in mm/day).
# For monthly totals, sum daily values; for annual, sum then divide by years as needed..

# 1. Authenticate in your own environment before running:
#   ee.Authenticate()
#   ee.Initialize(project='YOUR_GEE_PROJECT_ID')
# 2. Define the geometry from the HeraOculus selection.
geometry = ee.Point([91.8687, 24.8948])

# 3. Load the collection, filter by date, select band(s), apply scale & masks.

def scale_and_mask(img):
    
    scaled = img.select("precipitation").multiply(1).add(0)
    
    
    return scaled.rename('value').copyProperties(img, ['system:time_start'])

collection = (ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
    .filterDate('2024-01-01', '2024-12-31')
    .select(["precipitation"])
    .map(scale_and_mask)
)

# 4. Apply temporal aggregation.
aggColl = collection

# 5. Export / chart (earthengine-api has no ui.Chart; export CSV/TIFF).
def reduce_image(img):
    val = img.reduceRegion(
        reducer=ee.Reducer.mean(),
        geometry=geometry,
        scale=5566,
        maxPixels=1e9,
        bestEffort=True
    )
    return ee.Feature(None, {
        'date': img.date().format('YYYY-MM-dd'),
        'value': val.get('value')
    })
features = aggColl.map(reduce_image)
fc = ee.FeatureCollection(features)
Export.table.toDrive(
    collection=fc,
    description='HeraOculus_precip_2024-01-01_2024-12-31',
    fileFormat='CSV'
)

# End of HeraOculus GEE script."
`;

