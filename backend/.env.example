# HeraOculus Phase 2 FastAPI Backend Configuration
# Copy to .env and populate optional NASA credentials for live authenticated feeds.
# When omitted, keyless endpoints (EONET, ASF Search, CMR, POWER, file uploads) work
# normally and authenticated workflows transparently return labeled synthetic_demo data.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Explicit CORS allowlist (comma-separated). Only these origins are allowed;
# there is no wildcard/regex allowance.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Optional API key. When set, every /api/v1/* route except /api/v1/health
# requires an X-API-Key header (compared with secrets.compare_digest).
# When unset, the backend runs in dev mode and all requests are allowed.
# This is a server-only variable: the frontend never sees it. The Vercel
# proxy injects X-API-Key on behalf of the browser.
HERAOCULUS_API_KEY=

# Trust X-Forwarded-For for rate-limit keying when the backend runs behind a
# trusted reverse proxy (e.g. Vercel). Set to true only in production behind
# a proxy that overwrites X-Forwarded-For from the TCP connection. When off,
# the socket peer address is used so clients cannot spoof X-Forwarded-For to
# evade rate limits.
TRUST_PROXY_HEADERS=false

# NASA FIRMS MAP_KEY (free registration at https://firms.modaps.eosdis.nasa.gov/api/area/)
NASA_FIRMS_MAP_KEY=

# NASA Earthdata Login (EDL) for earthaccess, AppEEARS, GES DISC, PO.DAAC, NSIDC
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Climate Data Store (CDS) API key for ERA5-Land (queue-throttled;
# prefer the ARCO Zarr mirror for faster, non-queued access)
CDS_API_KEY=
CDSAPI_KEY=

# DestinE Earth Data Hub personal access token for ERA5-Land ARCO Zarr mirror
DESTINE_PAT=
